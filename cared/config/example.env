# 복사해서 config/{영문병원명}.env 로 쓰고 값을 채운다.
#   cp config/example.env config/wonju.env
#   ./deploy.sh pre 에서 env 설정을 완료한 뒤 run 한다

HOSPITAL=wonju

# VOLUME_DIR 은 템플릿 .env 를 그대로 쓴다. 여기서 넣지 말 것.
SYNC_IMAGE_TAG=vc-v2.1.5-latest

DB_ENCRYPTION_KEY=
DB_ENCRYPTION_KEY_HASH=
# VC_MYSQL_PASSWORD=

VCSYNC_EMR_HOSPITAL=
VCSYNC_EMR_HOST=
VCSYNC_EMR_PORT=
VCSYNC_EMR_SERVICE=

# 검수. override mysql 포트는 13306
INSPECT_VERSION=214
INSPECT_DB_HOST=127.0.0.1
INSPECT_DB_PORT=13306
INSPECT_PREDICTION_SCORES=MAES,SEPS,MORS,CARED
INSPECT_MEDICAL_SCORES=NEWS,MEWS
# INSPECT_BASE_DATE=2026-09-19
INSPECT_USE_ALTICU=N
